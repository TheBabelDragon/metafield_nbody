{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metafield-nbody/provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "operator", "origin", "physical", "inputs", "params", "scenario"],
  "properties": {
    "source": {"type": "string", "enum": ["metafield-nbody"]},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "src_sha256"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "src_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "origin": {"const": "synthetic"},
    "physical": {"const": false},
    "inputs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "minItems": 1, "maxItems": 1},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G", "softening", "eta", "dt_min", "dt_max", "theta"],
      "properties": {
        "G": {"type": "number"}, "softening": {"type": "number"}, "eta": {"type": "number"},
        "dt_min": {"type": "number"}, "dt_max": {"type": "number"}, "theta": {"type": "number"}
      }
    },
    "scenario": {"type": "string"}
  }
}
